{
  "manifest_version": 3,
  "name": "Tab Palette",
  "description": "A keyboard-first tab switcher and browser search palette.",
  "version": "1.1.1",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "history",
    "bookmarks",
    "search",
    "storage",
    "nativeMessaging",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tab Palette"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Tab Palette"
    }
  },
  "chrome_url_overrides": {
    "newtab": "bridge.html"
  },
  "optional_host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
